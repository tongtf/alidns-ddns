[Unit]
Description=AliDNS DDNS (single run)
Documentation=https://github.com/tongtf/alidns-ddns
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
# 与常驻单元保持一致：以动态临时用户运行，避免 root 持有状态文件
DynamicUser=yes
ExecStart=/usr/local/bin/alidns-ddns --config /etc/alidns-ddns/config.json --once
EnvironmentFile=/etc/alidns-ddns/env

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
# 禁止 W+X 内存；二进制因此不能使用 UPX 等运行时自解压壳
MemoryDenyWriteExecute=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK AF_LOCAL AF_INET AF_INET6
UMask=0077
# 注意：常驻服务与 --once timer 共用同一状态文件，二者只能启用其一
StateDirectory=alidns-ddns
