# 阿里云凭证（必填；建议改用 systemd LoadCredential，见 README；不要写进 config.json）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# 域名配置（必填）
ALIDNS_DOMAIN=example.com
ALIDNS_RR=@

# 可选配置
DDNS_IPV=6
DDNS_INTERVAL=300
# IP 未变时的 DNS 对账周期（秒）。稳态下几乎是零 API 调用
DDNS_VERIFY_INTERVAL=21600
DDNS_TTL=600
DDNS_LINE=default
# auto / stable / temporary：IPv6 地址选取策略
ALIDNS_IPV6_PREFER=auto
# 是否允许把 ULA(fc00::/7) 写进 AAAA（默认 false：公网不可达）
# DDNS_ALLOW_ULA=false
# IP 实际变化后执行的命令（可 reload 邮件服务、通知 acme.sh 等）
# DDNS_ON_CHANGE=systemctl reload postfix
# DDNS_ON_CHANGE_TIMEOUT=60

# 状态文件（默认由 STATE_DIRECTORY / XDG_STATE_HOME / HOME 推导）
# DDNS_STATE_FILE=/var/lib/alidns-ddns/state.json
# 指定网卡以获取本地 IPv6（Linux 如 eth0，macOS 如 en0）；留空则自动搜索可用网卡
ALIDNS_INTERFACE=
