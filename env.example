# 凭证（必填；不要写进 config.json）
# 推荐使用 systemd LoadCredential（见 README），否则用下面两行
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# 域名与基础设置（如需覆盖 config.json 才填；两者重复时以本文件为准）
# DDNS_DOMAIN=example.com
# DDNS_RR=@
# DDNS_IPV=46
# DDNS_INTERFACE=
# DDNS_IPV6_PREFER=auto
# DDNS_ALLOW_ULA=false
# DDNS_INTERVAL=300
# DDNS_VERIFY_INTERVAL=21600
# DDNS_TTL=600
# DDNS_LINE=default
# DDNS_ON_CHANGE=
# DDNS_ON_CHANGE_TIMEOUT=60

# 部署相关（不属于业务配置，故不写入 config.json）
# DDNS_STATE_FILE=/var/lib/private/alidns-ddns/state.json
# DDNS_NO_EVENTS=0
# DDNS_VERBOSE=0
