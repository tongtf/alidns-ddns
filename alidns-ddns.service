[Unit]
Description=AliDNS DDNS Service
Documentation=https://github.com/tongtf/alidns-ddns
After=network-online.target time-sync.target
Wants=network-online.target
# 配置/鉴权错误退出 78 时不再重启，避免无限重启刷屏（见 RestartPreventExitStatus）
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Type=notify + WatchdogSec：进程挂死时由 systemd 重启（本程序每 20s 喂一次）
Type=notify
# 与 once 单元保持一致：动态临时用户 + StateDirectory，钩子无权 reload root 服务
DynamicUser=yes
NotifyAccess=main
WatchdogSec=300
ExecStart=/usr/local/bin/alidns-ddns --config /etc/alidns-ddns/config.json
EnvironmentFile=/etc/alidns-ddns/env

# 成功即退出（--once）时不重启；失败按退避重启
Restart=on-failure
RestartSec=10
# sysexits.h: EX_CONFIG=78 → 配置或鉴权问题，重启无意义
RestartPreventExitStatus=78
UMask=0077
# 持久化期望值缓存/退避/端点粘性；systemd 会导出 $STATE_DIRECTORY
# 注意：常驻服务与 --once timer 共用同一状态文件，二者只能启用其一
StateDirectory=alidns-ddns

# --- 文件系统只读隔离 ---
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/

# --- 内核 / 硬件 / 命名空间收缩 ---
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

# --- 进程 / 能力 / 权限提升限制 ---
# 本程序不需要任何 capability：网络与 netlink 都在普通用户权限内
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
# 禁止 W+X 内存；二进制因此不能使用 UPX 等运行时自解压壳
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivatePIDs=yes
KeyringMode=private

# --- 仅放行必要的网络地址族（HTTPS + netlink 地址读取 + NOTIFY_SOCKET） ---
RestrictAddressFamilies=AF_NETLINK AF_LOCAL AF_INET AF_INET6

# 推荐（systemd >= 247）：AK/SK 由凭据文件注入（优先级高于 EnvironmentFile）
# 先创建 /etc/alidns-ddns/access_key_id 与 access_key_secret（root:root 600）
# 详见 README「用 systemd LoadCredential 传递凭证」
#LoadCredential=alidns-access-key-id:/etc/alidns-ddns/access_key_id
#LoadCredential=alidns-access-key-secret:/etc/alidns-ddns/access_key_secret

[Install]
WantedBy=multi-user.target
